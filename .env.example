# Required before anyone can sign in to /admin.
# Generate a long random string and keep it out of git.
HOGAR_YA_SESSION_SECRET=

# Public site URL used for canonical links, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Leave empty until Hogar Ya confirms an official WhatsApp number.
# Digits only, country code included, for example 50400000000.
NEXT_PUBLIC_WHATSAPP_E164=

# Optional. Set to 1 only when new listings should be indexable real inventory.
# While unset, properties created in the panel are stored as demo and use noindex.
HOGAR_YA_PUBLISH_REAL=
